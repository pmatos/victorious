{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(ffprobe:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-fmt-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
